---
import Layout from '../layouts/Layout.astro';
---

<Layout title={"Meet Callum Daley-West"}>
	<div class="px-4 py-8 mx-auto ">
	<div class="max-w-screen-md mx-auto flex flex-col items-center justify-center">
          <img
            class="my-6 rounded-full"
            src="/cdw_outdoors_headshot.png"
            width="150"
            height="150"
            alt="Photo of Callum Daley-West"
          />
          <h1 class="text-4xl font-bold">Welcome</h1>
          <p class="my-4 text-[1.25rem] text-center" >
          I am a full stack web developer working from the UK.  This site will let you learn about me, reveal a few of my thoughts, point you to some of my work and help you reach out if you want to make contact.<br/><br/>Take a look at this <a class="font-bold" href='/about'>about me</a> page to learn a little of my background.<br/><br/>Or have a look at these see some of my work:
          </p>
          <h4 class="text-center">Latest Post</h4>
          <a href="/posts/post2" class="italic text-[1.25rem] text-center">Migrating to Astro and Workers: A note on changing hosts and frameworks</a>
          <h4 class='text-center'>Pick from the Trove</h4>
          <a class="italic text-[1.25rem] text-center" href="https://elf-exchange.callumdw.dev/" target="_blank">Elf Exchange: A simple tool to help you generate random pairs for a gift exchange group</a>
        </div>
      </div>
</Layout>
