---
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.jsx'
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Toggle from '../components/Toggle.jsx'

interface Props {
	title: string
}

const {title} = Astro.props
---
		<!DOCTYPE html>
    <html data-theme='dark'>
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
				<link rel="icon" type="image/png" href="/favicon.png"/>
				<title>{title}</title>
				<ClientRouter />
      </head>
      <body class="min-h-dvh">
    		<div class="flex min-h-screen flex-col justify-between">
      		<div class='md:flex-row md:justify-between flex flex-col pt-[1em] ml-[2em] mr-[2em] items-center'>
						<a href="/" class={`text-[1.25em]`}>
	  					<h2 class='logo text-[2rem] font-bold'>CDW</h2>
						</a>
					<div class='flex gap-[1.25em] items-center justify-center'>
					<Nav client:load/>
					<Toggle client:load/>
					</div>
					</div>     
    			<main>
						<slot/>
					</main>
					<Footer/>
				</div>
	</body>
</html>
