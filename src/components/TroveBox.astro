---
interface Props {
  href:string,
  title:string,
  imgURL:string,
  alt:string,
  description:string
}

const {href, title, imgURL, alt, description} = Astro.props
---
<a href={href} target='_blank'>
	<div class="box max-w-4xl p-[1em] rounded-xl flex flex-col md:flex-row">
		<img class="rounded-xl my-[1em] md:w-[100%] object-contain md:object-cover" src={imgURL} alt={alt}/>
		<div class="md:max-w-[50%]">
			<h4 class="text-[1.25em] text-center md:text-left font-bold mx-[1em]">{title}</h4>
			<p class="mx-[1em] text-center md:text-left">{description}</p>
    </div>
	</div>
</a>
